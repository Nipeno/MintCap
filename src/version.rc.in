//
// Windows VERSIONINFO resource for MintCap.addon64.
//
// Generated by CMake from this template (configure_file, @ONLY): @MINTCAP_VERSION@ /
// @MINTCAP_VERSION_COMMA@ are substituted at configure time. The installer reads the
// resulting FILEVERSION back off the installed .addon64 to decide install vs update.
// Do not edit the generated build/version.rc — edit this template instead.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @MINTCAP_VERSION_COMMA@
 PRODUCTVERSION @MINTCAP_VERSION_COMMA@
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"   // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "Nipeno"
            VALUE "FileDescription",  "MintCap - ReShade addon that caps the game to a chosen FPS"
            VALUE "FileVersion",      "@MINTCAP_VERSION@"
            VALUE "InternalName",     "MintCap"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Nipeno. All rights reserved."
            VALUE "OriginalFilename", "MintCap.addon64"
            VALUE "ProductName",      "MintCap"
            VALUE "ProductVersion",   "@MINTCAP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200   // U.S. English, Unicode codepage
    END
END
